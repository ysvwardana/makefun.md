# ==============================================================================
# COSMICLABS Make.fun Command Center — Environment Variables
# ==============================================================================
# Local setup: copy to `.env` (never commit `.env` with real secrets).
# Cloud / hosting setup: configure via your platform's environment variables / secret manager.

# Server-side Google Gemini API key (required when provider is "gemini")
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Optional API key for OpenAI-compatible gateways (sent ONLY to saved & allowlisted URLs)
# Local Ollama/vLLM/LM Studio normally does not require an API key.
OPENAI_COMPAT_API_KEY=""

# Comma-separated non-loopback hostnames permitted for OpenAI-compatible Base URLs
# Loopback hosts (localhost, 127.0.0.1, ::1) are always permitted; all private/metadata IPs are blocked.
ALLOWED_OPENAI_COMPAT_HOSTS=""

# Server-side authorization for paid-tier Gemini models (gemini-4-argon, gemini-4-carbon)
# Set to "true" only if you explicitly authorize paid billing; cannot be enabled from client UI.
ALLOW_PAID_LLM_REQUESTS="false"

# Optional operator token protecting mutating /api/* endpoints (Bearer or X-Operator-Token)
COMMAND_CENTER_TOKEN=""

# Optional server safety & budget caps
MAX_DAILY_LLM_CALLS="50"
MAX_LLM_OUTPUT_TOKENS="8192"

# Network binding (defaults to 127.0.0.1 locally; set to 0.0.0.0 only behind a trusted reverse proxy)
HOST="127.0.0.1"
PORT="3000"

# Hosting URL (injected automatically by Cloud Run / AI Studio runtime when deployed)
APP_URL="http://localhost:3000"
