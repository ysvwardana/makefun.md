# Local-only application listener. Remote/non-loopback binding is not supported.
# Accepted HOST values: 127.0.0.1, ::1, localhost
HOST=127.0.0.1
PORT=3000

# Credentials are read only by the server. Never place keys in UI fields or URLs.
OPENAI_COMPAT_API_KEY=""

# Approved OpenAI-compatible endpoint. Settings cannot override this destination.
# HTTP(S) only; no credentials, query string, or fragment. Restart after changes.
OPENAI_COMPAT_BASE_URL="http://localhost:11434/v1"

# Required for hosted HTTPS endpoints (provider usage may be billable).
# This is a server policy, not a spending cap or a zero-cost guarantee.
LLM_ALLOW_PAID_REQUESTS=false

# Bounds for LLM requests (milliseconds, bytes, active requests, requests/minute).
LLM_REQUEST_TIMEOUT_MS=60000
LLM_MAX_RESPONSE_BYTES=1048576
LLM_MAX_CONCURRENT_REQUESTS=2
LLM_MAX_REQUESTS_PER_MINUTE=10

# Reject oversized full rule context before a provider call; never truncate mandatory rules.
LLM_MAX_CONTEXT_CHARS=400000
# Optional output limit; adjust for the selected model's supported parameter.
LLM_MAX_COMPLETION_TOKENS=8192
